POSTGRES_HOST=host.docker.internal
POSTGRES_PORT=5432
POSTGRES_DB=tps_db
POSTGRES_USER=tps_app
POSTGRES_PASSWORD=change_me_now
# Local (non-container) runs override the host:
# POSTGRES_HOST=localhost

# --- Managed database (Render / Supabase) -----------------------------------
# A single connection string that OVERRIDES the five POSTGRES_* values above when set.
# Leave it UNSET for local development. On Render this is a dashboard secret (never
# committed); see DEPLOYMENT.md. Use the Supabase **session pooler** host — the direct
# db.<ref>.supabase.co host is IPv6-only and unreachable from most platforms.
# DATABASE_URL=postgresql://postgres.<ref>:PASSWORD@aws-0-<region>.pooler.supabase.com:5432/postgres
#
# TLS is auto-enabled for any non-local host. Override only if you must:
# DB_SSL=true
# DB_SSL_INSECURE=false   # last resort if certificate verification fails
#
# Conservative pool for a managed database's connection budget:
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=5

# Application timezone (D5). Storage is always UTC; this is for display only.
APP_TIMEZONE=Africa/Kampala

# Argon2id parameters. The seed hashes the demo accounts with exactly these
# values, so Phase 2's verifier must read them from here rather than hard-coding
# its own — otherwise every seeded account fails to log in.
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=4
ARGON2_HASH_LENGTH=32
ARGON2_SALT_LENGTH=16

# Deterministic seed (§7.1). Changing this changes the whole dataset.
SEED_RANDOM_SEED=20260722

# --- Phase 2: API -----------------------------------------------------------
ENVIRONMENT=development
APP_VERSION=1.0.0
GIT_COMMIT=unknown
LOG_LEVEL=INFO

# REQUIRED outside development. Generate with:  openssl rand -hex 32
# Never ship a default. A weak or shared signing key means every token is forgeable.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Comma-separated. Never '*' — allow_credentials forbids a wildcard origin.
CORS_ORIGINS=http://localhost:5173

RATE_LIMIT_LOGIN=10/minute
RATE_LIMIT_SIMULATE=30/minute

# Log a WARNING above this many milliseconds. NFR-01's ceiling is 10 000 ms;
# warning at 3 000 surfaces degradation long before it breaches.
PREDICTION_SLOW_WARNING_MS=3000
